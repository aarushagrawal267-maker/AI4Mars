# Mars Terrain Intelligence - local configuration
#
# Copy this file to .env (setup.ps1 / setup.sh do it for you). Every setting is optional: a missing or
# commented-out line uses the default shown. Values are read by backend/app/core/config.py from
# environment variables with the MTI_ prefix, or from this .env file in the repository root.
# Real environment variables take precedence over values in .env.

# --- Storage locations -------------------------------------------------------------------------------
# Defaults are folders inside the repository. Use absolute paths if you change them.

# Root data folder: dataset (raw/, raw/imports/), preprocessing cache (processed/), stored image
# analyses (analyses/) and the default SQLite database file. Default: <repo>/data
# MTI_DATA_DIR=C:\path\to\AI4Mars\data

# Trained model checkpoints, one folder per experiment (best.pt, last.pt). Default: <repo>/checkpoints
# MTI_CHECKPOINT_DIR=C:\path\to\AI4Mars\checkpoints

# Per-run training files (job.json, status.json, history.jsonl, control.json, train.log).
# Default: <repo>/experiments
# MTI_EXPERIMENTS_DIR=C:\path\to\AI4Mars\experiments

# SQLAlchemy database URL. Empty = SQLite file at <MTI_DATA_DIR>/mti.sqlite3.
# MTI_DATABASE_URL=sqlite:///C:/path/to/mti.sqlite3

# --- Upload and output limits ------------------------------------------------------------------------

# Maximum size of an uploaded image in megabytes (larger uploads are rejected with HTTP 413).
MTI_MAX_UPLOAD_MB=20

# Longest side, in pixels, of stored prediction outputs (mask, overlay, confidence maps).
# Larger inputs are downscaled to this for output; smaller inputs keep their size.
MTI_MAX_OUTPUT_SIDE=1536

# --- Web ---------------------------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API directly (CORS). The Vite dev server
# proxies /api, so this matters only if the UI is served from another origin.
MTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dataset split -----------------------------------------------------------------------------------
# Changing either value produces a different train/validation split (and a new dataset fingerprint)
# the next time the dataset is loaded. The official expert test set is never affected.

# Fraction of the training pairs held out for validation, split by rover position (site + drive).
MTI_VAL_FRACTION=0.1

# Random seed for the grouped train/validation split and for subset selection when downloading.
MTI_SPLIT_SEED=42

# --- Testing -----------------------------------------------------------------------------------------

# Registers a clearly labelled UNTRAINED fixture model ("TEST FIXTURE - untrained U-Net (not a real
# model)") used only by automated UI tests, so they can exercise inference without a trained
# checkpoint. Its output is meaningless. Keep this false for normal use.
MTI_ENABLE_TEST_FIXTURE=false

# --- Logging -----------------------------------------------------------------------------------------

# Backend log level: DEBUG, INFO, WARNING or ERROR.
MTI_LOG_LEVEL=INFO
