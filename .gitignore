# Python
.venv/
venv/
env/
.python-version
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/

# Local data, models and run outputs (never committed)
data/*
checkpoints/*
experiments/*
!data/.gitkeep
!checkpoints/.gitkeep
!experiments/.gitkeep
*.pt
*.pth
*.sqlite3
*.sqlite3-*

# Runtime
.env
.env.*
!.env.example
.run/
*.log
.DS_Store
Thumbs.db

# Deployment staging and secrets
deploy/stage/
deploy/admin_token.txt
deploy/mti-demo-bundle.zip
deploy/mti-demo-bundle.sha256
frontend/public-demo/
frontend/dist-demo/
deploy/hf-space/

# The committed demo bundle for hosted deployments (overrides the *.pt / *.sqlite3 rules above)
!deploy/bundle/**
deploy/bundle/**/*.sqlite3-*
deploy/hf-static/
.mti_admin_token

# Credentials and local secrets (never committed)
.streamlit/secrets.toml
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.netrc
.huggingface/
credentials.json
service-account*.json

# Data dumps outside data/ (the demo bundle above stays tracked)
*.sqlite
*.db
*.dump
*.sql.gz
